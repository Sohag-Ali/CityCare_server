model ServiceRequest {
  id             String          @id @default(uuid())
  trackingNumber String          @unique
  citizenId      String
  serviceId      String
  title          String
  description    String
  priority       ServicePriority @default(MEDIUM)
  status         RequestStatus   @default(SUBMITTED)
  isPaid         Boolean         @default(false)
  amount         Decimal?        @db.Decimal(12, 2)
  currency       String?
  paymentStatus  PaymentStatus   @default(NOT_REQUIRED)
  responseDueAt         DateTime?
  resolutionDueAt       DateTime?
  responseStartedAt     DateTime?
  responseCompletedAt   DateTime?
  resolutionStartedAt   DateTime?
  resolutionCompletedAt DateTime?
  isDeleted             Boolean                @default(false)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  citizen           Citizen                  @relation(fields: [citizenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service           MunicipalService         @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location          RequestLocation?
  attachments       RequestAttachment[]
  statusHistory     RequestStatusHistory[]
  assignments       Assignment[]
  technicianUpdates TechnicianUpdate[]
  resolutions       Resolution[]
  verifications     ResolutionVerification[]
  slaEvents         SlaEvent[]
  escalations       Escalation[]
  payments          Payment[]

  @@index([citizenId], name: "idx_request_citizenId")
  @@index([serviceId], name: "idx_request_serviceId")
  @@index([status], name: "idx_request_status")
  @@index([paymentStatus], name: "idx_request_paymentStatus")
  @@index([isDeleted], name: "idx_request_isDeleted")
  @@index([createdAt], name: "idx_request_createdAt")
  @@index([responseDueAt], name: "idx_request_responseDueAt")
  @@index([resolutionDueAt], name: "idx_request_resolutionDueAt")
  @@map("service_requests")
}

model RequestLocation {
  id        String   @id @default(uuid())
  requestId String   @unique
  wardId    String
  address   String
  area      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  serviceRequest ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ward           Ward           @relation(fields: [wardId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([wardId], name: "idx_location_wardId")
  @@map("request_locations")
}

model RequestAttachment {
  id                 String            @id @default(uuid())
  requestId          String
  fileUrl            String
  filePublicId       String?
  fileName           String?
  fileType           String?
  fileSize           Int?
  uploadedById       String?
  evidenceType       EvidenceType?     @default(OTHER)
  technicianUpdateId String?
  resolutionId       String?
  createdAt          DateTime          @default(now())

  // Relations
  serviceRequest   ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy       User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  technicianUpdate TechnicianUpdate? @relation(fields: [technicianUpdateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolution       Resolution?       @relation(fields: [resolutionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([requestId], name: "idx_attachment_requestId")
  @@index([uploadedById], name: "idx_attachment_uploadedById")
  @@index([technicianUpdateId], name: "idx_attachment_technicianUpdateId")
  @@index([resolutionId], name: "idx_attachment_resolutionId")
  @@map("request_attachments")
}

model RequestStatusHistory {
  id          String         @id @default(uuid())
  requestId   String
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  changedById String
  note        String?
  createdAt   DateTime       @default(now())

  // Relations
  serviceRequest ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedBy      User           @relation(fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([requestId], name: "idx_history_requestId")
  @@index([changedById], name: "idx_history_changedById")
  @@index([createdAt], name: "idx_history_createdAt")
  @@map("request_status_histories")
}

model ServiceRequestCounter {
  year  Int @id
  count Int @default(0)

  @@map("service_request_counters")
}
