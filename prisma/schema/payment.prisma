enum PaymentState {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id                    String       @id @default(uuid())
  serviceRequestId      String
  citizenId             String
  amount                Decimal      @db.Decimal(12, 2)
  currency              String       @default("BDT")
  status                PaymentState @default(PENDING)
  paymentMethod         String       @default("BKASH")
  merchantInvoiceNumber String       @unique
  bkashPaymentId        String?
  bkashTransactionId    String?
  initiatedAt           DateTime     @default(now())
  completedAt           DateTime?
  failedAt              DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  citizen        Citizen        @relation(fields: [citizenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events         PaymentEvent[]

  @@index([serviceRequestId], name: "idx_payment_serviceRequestId")
  @@index([citizenId], name: "idx_payment_citizenId")
  @@index([status], name: "idx_payment_status")
  @@index([bkashPaymentId], name: "idx_payment_bkashPaymentId")
  @@index([bkashTransactionId], name: "idx_payment_bkashTransactionId")
  @@map("payments")
}

model PaymentEvent {
  id        String       @id @default(uuid())
  paymentId String
  status    PaymentState
  eventType String
  payload   Json?
  note      String?
  createdAt DateTime     @default(now())

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([paymentId], name: "idx_payment_event_paymentId")
  @@map("payment_events")
}
