model ResolutionVerification {
  id               String               @id @default(uuid())
  serviceRequestId String
  resolutionId     String
  verifiedById     String
  decision         VerificationDecision
  comments         String?
  verifiedAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Relations
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resolution     Resolution     @relation(fields: [resolutionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verifiedBy     User           @relation(fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([serviceRequestId], name: "idx_verification_serviceRequestId")
  @@index([resolutionId], name: "idx_verification_resolutionId")
  @@index([verifiedById], name: "idx_verification_verifiedById")
  @@map("resolution_verifications")
}
